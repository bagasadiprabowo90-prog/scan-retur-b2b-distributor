# ============================================================
# SCAN RETUR - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# ⚠️ PENTING:
# 1. Salin file ini menjadi '.env' di root folder project.
# 2. Jangan pernah menyimpan file '.env' ke Git repository!
# 3. Di Vercel: masukkan variabel-variabel ini di Project Settings > Environment Variables.
# ============================================================

# URL Google Apps Script Web App (Wajib)
# Dapatkan setelah deploy Apps Script: Deploy > New deployment > Web App
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Google OAuth Client ID (Wajib untuk Google Sign-In @blpbeauty.com)
# Buat gratis di Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# API Secret Token (Opsional tapi disarankan untuk memproteksi endpoint Apps Script)
# Pastikan nilai ini SAMA dengan yang disimpan di Script Properties Apps Script.
# VITE_API_SECRET_TOKEN=blp_secure_token_secret_here
